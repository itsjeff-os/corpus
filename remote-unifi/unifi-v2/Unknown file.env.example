# ── UniFi connection ───────────────────────────────────────────────────────────
UNIFI_CONTROLLER=https://192.168.1.1        # your controller IP/hostname
UNIFI_API_KEY=your-api-key-here
UNIFI_SITE_ID=your-site-uuid-here           # v1 UUID, see README
UNIFI_SITE_NAME=default                     # legacy slug, usually "default"

# ── Transport ──────────────────────────────────────────────────────────────────
TRANSPORT=stdio                              # stdio | http
PORT=3000                                   # HTTP mode only

# ── Watcher thresholds (optional, these are the defaults) ──────────────────────
WATCHER_INTERVAL_MS=15000                   # poll every 15s
WAN_PACKET_LOSS_WARN=2                      # % — warning threshold
WAN_PACKET_LOSS_CRIT=10                     # % — critical threshold
WAN_LATENCY_WARN_MS=80                      # ms — warning threshold
WAN_LATENCY_CRIT_MS=200                     # ms — critical threshold
