# ── UniFi connection ───────────────────────────────────────────────────────────
UNIFI_CONTROLLER=https://192.168.1.1
UNIFI_API_KEY=your-api-key-here
UNIFI_SITE_ID=your-site-uuid-here
UNIFI_SITE_NAME=default

# ── Transport ──────────────────────────────────────────────────────────────────
# sse   = always-on SSE (default, for Cloudflare agents, orchestrators, remote clients)
# stdio = for Claude Desktop local use
TRANSPORT=sse
PORT=3000

# ── Watcher thresholds (optional) ─────────────────────────────────────────────
WATCHER_INTERVAL_MS=15000
WAN_PACKET_LOSS_WARN=2
WAN_PACKET_LOSS_CRIT=10
WAN_LATENCY_WARN_MS=80
WAN_LATENCY_CRIT_MS=200
